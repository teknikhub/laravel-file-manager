{
    "name": "teknikhub/laravel-file-manager",
    "description": "A filesystem-first, database-free File Manager and File Picker package for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "TeknikHub",
            "email": "hello@teknikhub.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "TeknikHub\\FileManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TeknikHub\\FileManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TeknikHub\\FileManager\\FileManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
